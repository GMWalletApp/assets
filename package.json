    "@types/react-dom": "19.2.5",
    "class-variance-authority": "0.7.1",
    "esbuild": "0.28.2",
    "fast-average-color": "9.5.2",
    "fzstd": "0.1.1",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.19.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^22.22.2 || >=24.15"
  }
